<Window x:Class="ResurectPhone.App.Dialogs.N9MaintenanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fonction Nokia N9" Width="880" Height="690" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="DescriptionText" Grid.Row="1" Margin="0,10,0,16" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}" />
        <ComboBox x:Name="Applications" Grid.Row="2" Margin="0,0,0,12" DisplayMemberPath="DisplayName"
                  Visibility="Collapsed" SelectionChanged="Application_SelectionChanged" />
        <Button x:Name="ChoosePackageButton" Grid.Row="2" Content="Choisir un fichier .deb" HorizontalAlignment="Left"
                Margin="0,0,0,12" Visibility="Collapsed" Click="ChoosePackage_Click" />
        <TextBlock x:Name="StatusText" Grid.Row="3" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBox x:Name="ReportText" Grid.Row="4" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Padding="12" FontFamily="Segoe UI" />
        <ProgressBar x:Name="Progress" Grid.Row="5" Height="4" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed" />
        <WrapPanel Grid.Row="6" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RefreshButton" Content="Vérifier à nouveau" Margin="0,0,8,8" Click="Refresh_Click" />
            <Button x:Name="ExportReportButton" Content="Enregistrer le rapport" Margin="0,0,8,8" Click="ExportReport_Click" />
            <Button x:Name="RestoreButton" Content="Restaurer les réglages" Margin="0,0,8,8" Visibility="Collapsed" Click="Restore_Click" />
            <Button x:Name="ForceButton" Content="Suppression en mode expert" Margin="0,0,8,8" Visibility="Collapsed" Click="Force_Click" />
            <Button x:Name="ApplyButton" Content="Appliquer" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                    IsEnabled="False" Click="Apply_Click" />
            <Button x:Name="CloseButton" Content="Fermer" Margin="0,0,0,8" Click="Close_Click" />
        </WrapPanel>
    </Grid>
</Window>
