<Window x:Class="ResurectPhone.App.Dialogs.N9PairingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Appairer le Nokia N9" Width="590" Height="430"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Text="Première connexion au Nokia N9" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="Instructions" Grid.Row="1" Margin="0,12,0,18" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Saisissez le mot de passe actuellement affiché par SDK Connectivity. ResurectPhone enregistrera ce PC pour les prochaines connexions USB." />
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="PasswordLabel" Text="Mot de passe affiché par SDK Connectivity" FontWeight="SemiBold" />
            <PasswordBox x:Name="PasswordInput" Margin="0,7,0,5" />
            <TextBlock x:Name="PasswordHint" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"
                       Text="Il ne s’agit ni du code de verrouillage du téléphone ni d’un mot de passe root. Ce mot de passe temporaire ne sera pas enregistré." />
        </StackPanel>
        <Border Grid.Row="3" Background="{StaticResource SubtleFillHoverBrush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                Padding="12" Margin="0,18,0,0" VerticalAlignment="Top">
            <TextBlock x:Name="FooterText" TextWrapping="Wrap"
                       Text="Une clé propre à ce PC permettra de se reconnecter même lorsque le mot de passe SDK change. Le mot de passe temporaire ne sera pas enregistré par ResurectPhone." />
        </Border>
        <Grid Grid.Row="4" Margin="0,18,0,0">
            <TextBlock x:Name="ValidationText" Foreground="#C42B1C"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,210,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Continuer" Style="{StaticResource PrimaryButton}" Click="Continue_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
