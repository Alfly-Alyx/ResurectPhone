<Window x:Class="ResurectPhone.App.Dialogs.N9PairingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Appairer le Nokia N9" Width="590" Height="430"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Autoriser la liaison développeur" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,12,0,18" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Sur le N9, ouvrez SDK Connectivity, choisissez USB et laissez cette application ouverte. ResurectPhone utilisera uniquement le compte developer." />
        <StackPanel Grid.Row="2">
            <TextBlock Text="Mot de passe affiché par SDK Connectivity" FontWeight="SemiBold" />
            <PasswordBox x:Name="PasswordInput" Margin="0,7,0,5" />
            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"
                       Text="Il ne s’agit ni du code de verrouillage du téléphone ni d’un mot de passe root. Ce mot de passe temporaire ne sera pas enregistré." />
        </StackPanel>
        <Border Grid.Row="3" Background="{StaticResource SubtleFillHoverBrush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                Padding="12" Margin="0,18,0,0" VerticalAlignment="Top">
            <TextBlock TextWrapping="Wrap"
                       Text="ResurectPhone vous montrera ensuite l’empreinte du N9. Après confirmation, il ajoutera une clé au seul compte developer et protégera sa partie privée avec votre compte Windows." />
        </Border>
        <Grid Grid.Row="4" Margin="0,18,0,0">
            <TextBlock x:Name="ValidationText" Foreground="#C42B1C"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,210,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Continuer" Style="{StaticResource PrimaryButton}" Click="Continue_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
