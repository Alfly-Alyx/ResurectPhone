<Window x:Class="ResurectPhone.App.Dialogs.N9HostKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmer le Nokia N9" Width="640" Height="430"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Confirmer l’identité du téléphone" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,12,0,18" Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="Cette empreinte identifie le serveur SSH du N9. ResurectPhone la conservera afin de refuser silencieusement tout autre appareil lors des prochaines connexions." />
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Background="{StaticResource SurfaceSecondaryBrush}" Padding="14">
            <StackPanel>
                <TextBlock Text="Empreinte SHA-256" FontWeight="SemiBold" />
                <TextBox Text="{Binding DisplayFingerprint}" Margin="0,7,0,12"
                         IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                         Background="Transparent" FontFamily="Consolas" />
                <TextBlock Text="{Binding KeyDescription}" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="#FFF4CE" BorderBrush="#E6B800"
                BorderThickness="1" Padding="12" Margin="0,18,0,0" VerticalAlignment="Top">
            <TextBlock TextWrapping="Wrap"
                       Text="Confirmez uniquement si vous venez d’activer SDK Connectivity sur votre propre N9. Une empreinte différente lors d’une connexion future sera considérée comme une anomalie." />
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Refuser" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Confirmer ce N9" IsDefault="True" Style="{StaticResource PrimaryButton}"
                    Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
